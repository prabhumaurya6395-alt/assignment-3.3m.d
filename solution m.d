1. Create college-info.html
Neeche diya gaya complete HTML code copy karke college-info.html naam se save kar do.


<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>College Information</title>
</head>

<body>

    <!-- Header Section -->
    <header>
        <h1>My College Information</h1>
        <p>Welcome to Our College</p>
    </header>

    <hr>

    <!-- College Introduction -->
    <section>
        <h2>About Our College</h2>

        <p>
            Our college provides quality education and helps
            students develop knowledge and skills.
            We offer different courses and departments
            to support students in their careers.
        </p>
    </section>

    <hr>

    <!-- Departments Section -->
    <section>
        <h2>Our Departments</h2>

        <ul>
            <li>Computer Science</li>
            <li>Information Technology</li>
            <li>Mechanical Engineering</li>
            <li>Electrical Engineering</li>
            <li>Civil Engineering</li>
        </ul>
    </section>

    <hr>

    <!-- Admission Process -->
    <section>
        <h2>Admission Process</h2>

        <ol>
            <li>Visit the college website.</li>
            <li>Fill out the admission application form.</li>
            <li>Submit the required documents.</li>
            <li>Pay the admission fees.</li>
            <li>Confirm your admission.</li>
        </ol>
    </section>

    <hr>

    <!-- Nested Subjects List -->
    <section>
        <h2>Computer Science Subjects</h2>

        <ul>
            <li>Programming
                <ol>
                    <li>C Programming</li>
                    <li>Python</li>
                    <li>Java</li>
                </ol>
            </li>

            <li>Web Development
                <ol>
                    <li>HTML</li>
                    <li>CSS</li>
                    <li>JavaScript</li>
                </ol>
            </li>

            <li>Database Management
                <ol>
                    <li>SQL</li>
                    <li>MySQL</li>
                </ol>
            </li>
        </ul>
    </section>

    <hr>

    <!-- Course Details -->
    <section>
        <h2>Course Details</h2>

        <dl>
            <dt><strong>Bachelor of Computer Applications (BCA)</strong></dt>
            <dd>A course focused on computer applications and programming.</dd>

            <dt><strong>HTML</strong></dt>
            <dd>A markup language used to create webpages.</dd>

            <dt><strong>CSS</strong></dt>
            <dd>A stylesheet language used to design webpages.</dd>

            <dt><strong>JavaScript</strong></dt>
            <dd>A programming language used to make webpages interactive.</dd>
        </dl>
    </section>

    <hr>

    <!-- Teacher Details -->
    <section>
        <h2>Teacher Information</h2>

        <dl>
            <dt><strong>Computer Teacher</strong></dt>
            <dd>Teaches programming and computer fundamentals.</dd>

            <dt><strong>Web Development Teacher</strong></dt>
            <dd>Teaches HTML, CSS, and JavaScript.</dd>
        </dl>
    </section>

    <hr>

    <!-- Footer -->
    <footer>
        <p>Created by Your Name | 2026</p>
        <p>Thank you for visiting our college information page!</p>
    </footer>

</body>

</html>
